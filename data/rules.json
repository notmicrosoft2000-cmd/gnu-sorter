[
  {
    "name": "Photos/Screenshots",
    "extensions": [],
    "match_name_regex": "screenshot|ibis|scree.?shot|capture"
  },
  {
    "name": "Photos",
    "extensions": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "webp",
      "heic",
      "bmp",
      "tiff",
      "avif",
      "svg",
      "ico",
      "raw",
      "psd",
      "xcf"
    ]
  },
  {
    "name": "Videos",
    "extensions": [
      "mp4",
      "mkv",
      "webm",
      "mov",
      "avi",
      "flv",
      "m4v",
      "wmv",
      "mpeg",
      "mpg",
      "3gp",
      "ts",
      "m2ts"
    ]
  },
  {
    "name": "Music",
    "extensions": [
      "mp3",
      "flac",
      "wav",
      "ogg",
      "m4a",
      "aac",
      "opus",
      "wma",
      "mid",
      "midi"
    ]
  },
  {
    "name": "Documents",
    "extensions": [
      "pdf",

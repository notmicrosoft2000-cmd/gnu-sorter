      "zst",
      "lz4"
    ]
  },
  {
    "name": "Installers",
    "extensions": [
      "appimage",
      "deb",
      "rpm",
      "apk",
      "exe",
      "msi",
      "dmg",
      "pkg",
      "run",
      "flatpak",
      "flatpakref"
    ]
  },
  {
    "name": "ISOs",
    "extensions": [
